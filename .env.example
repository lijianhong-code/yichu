# Server-side AI configuration. Never expose these values with NEXT_PUBLIC_.
OPENAI_API_KEY=sk-your-key
# Provider root (for example https://api.openai.com/v1) or a full
# /chat/completions endpoint.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional tuning
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=2
# Set false for gateways that do not support response_format=json_object.
OPENAI_JSON_MODE=true
# Optional OpenAI project headers
# OPENAI_ORG_ID=org_xxx
# OPENAI_PROJECT_ID=proj_xxx
